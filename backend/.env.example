# ============================================================================
# Бэкенд конфигурация (пример — скопируйте в .env и заполните своими значениями)
# .env НЕ пушится в GitHub
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# URL ядра (от организаторов хакатона)
CORE_URL=https://tm-test-yakut.hostco.ru/

# Личный токен авторизации (от организаторов)
AUTH_TOKEN=your-auth-token-here

# Эндпоинт для получения данных пользователя
USER_FOR_EXTERNAL_SERVICE_ENDPOINT=/api/v3/users/user-for-external-service

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
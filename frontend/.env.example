# ============================================================================
# Фронтенд конфигурация (пример — скопируйте в .env и заполните своими значениями)
# .env НЕ пушится в GitHub
# Переменные с префиксом VITE_ доступны в коде через import.meta.env
# ============================================================================

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CORE_URL=https://tm-test-yakut.hostco.ru/
VITE_AUTH_TOKEN=your-auth-token-here
VITE_DEBUG=true